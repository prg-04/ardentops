# ── WordPress Classic — Environment Variables ──────────────────

APP_ENV=development
APP_URL=http://localhost:8080

# Database
DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=wordpress
DB_HOST=database
DB_PREFIX=wp_

# WordPress Security Keys
# Generate: https://roots.io/salts.html
AUTH_KEY=
SECURE_AUTH_KEY=
LOGGED_IN_KEY=
NONCE_KEY=
AUTH_SALT=
SECURE_AUTH_SALT=
LOGGED_IN_SALT=
NONCE_SALT=
