{
  "semi": true,
  "singleQuote": true,
  "trailingComma": "es5",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "bracketSpacing": true,
  "arrowParens": "always",
  "endOfLine": "lf",
  "overrides": [
    {
      "files": "*.php",
      "options": {
        "phpVersion": "8.2",
        "tabWidth": 4,
        "useTabs": false
      }
    }
  ]
}
